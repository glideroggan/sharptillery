{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "testapi: (re)start container (8080)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-Command",
        "docker rm -f testapi-dev 2>$null; docker run -d --name testapi-dev -p 8080:80 -m 500m --memory-reservation 50m --cpus=0.5 testapi:dev"
      ],
      "problemMatcher": []
    },
    {
      "label": "sharptillery: run against local testapi",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-Command",
        "dotnet run --project .\\src\\SharpArtillery\\SharpArtillery.csproj -- -t http://localhost:8080/Test/get -m GET -c 1 -n 10"
      ],
      "dependsOn": [
        "testapi: (re)start container (8080)"
      ],
      "problemMatcher": []
    }
  ]
}
